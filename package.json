{
  "name": "claude-receipt",
  "version": "0.2.1",
  "description": "Local-first receipts for Claude Code sessions: hard stats, coding stats and session lore, in the terminal or as an image",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aaryaman-147/claude-receipt.git"
  },
  "homepage": "https://github.com/Aaryaman-147/claude-receipt",
  "bugs": {
    "url": "https://github.com/Aaryaman-147/claude-receipt/issues"
  },
  "type": "module",
  "bin": {
    "claude-receipt": "bin/claude-receipt.js"
  },
  "files": [
    "bin/",
    "dist/",
    "assets/fonts/"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\"",
    "typecheck": "tsc -p .",
    "receipt": "node src/cli/main.ts",
    "dev:parse": "node src/dev/parse.ts"
  },
  "keywords": [
    "claude-code",
    "claude",
    "receipt",
    "cli",
    "local-first"
  ],
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
